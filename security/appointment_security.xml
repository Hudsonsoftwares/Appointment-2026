<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <record model="res.groups.privilege" id="res_groups_privilege_appointment">
            <field name="name">Appointments</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <record id="group_appointment_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_appointment"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will have access to his own data in the appointment application.</field>
        </record>

        <record id="group_appointment_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_appointment"/>
            <field name="implied_ids" eval="[(4, ref('appointment.group_appointment_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">The user will have access to all records of everyone in the appointment application.</field>
        </record>
    </data>
</odoo>
