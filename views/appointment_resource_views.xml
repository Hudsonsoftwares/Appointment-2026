<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="appointment_resource_view_form" model="ir.ui.view">
            <field name="name">appointment.resource.view.form</field>
            <field name="model">appointment.resource</field>
            <field name="arch" type="xml">
                <form string="Resource">
                    <sheet>
                        <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                        <div class="oe_title mb-4">
                            <label for="name" class="oe_edit_only" string="Name"/>
                            <h1><field name="name" placeholder="e.g. Table 1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="capacity"/>
                                <field name="shareable"/>
                                <field name="linked_resource_id" placeholder="Does not combine"/>
                            </group>
                            <group>
                                <field name="opening_hours_id"/>
                                <field name="timezone"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Description of the resource..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="appointment_resource_view_list" model="ir.ui.view">
            <field name="name">appointment.resource.view.list</field>
            <field name="model">appointment.resource</field>
            <field name="arch" type="xml">
                <list string="Resources">
                    <field name="name"/>
                    <field name="appointment_type_ids" string="Available in" widget="many2many_tags"/>
                    <field name="linked_resource_id"/>
                    <field name="shareable"/>
                    <field name="capacity"/>
                </list>
            </field>
        </record>

        <record id="action_appointment_resource" model="ir.actions.act_window">
            <field name="name">Resources</field>
            <field name="res_model">appointment.resource</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
